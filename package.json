{
  "name": "qa-agent-mcp",
  "version": "1.0.0",
  "description": "Local-first MCP server that acts as an autonomous QA engineer with screenshot results",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "qa-agent-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "bun run src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "install:browser": "playwright install chromium",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test --test-timeout=120000 dist-test/",
    "install:skills": "bash scripts/install-skills.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright": "^1.49.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
